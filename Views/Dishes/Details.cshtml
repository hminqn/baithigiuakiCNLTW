@model DishDetail
@{ var dish = Model.Dish; ViewData["Title"] = dish.Name; }
<a class="back-link" asp-action="Index">← @T["Back"]</a>
<section class="detail-top">
    <div><div class="eyebrow">@dish.DishCategory.Name</div><h1>@dish.Name</h1><p>@dish.Description</p>
        <div class="detail-badges"><span class="status-badge @(dish.IsAvailable ? "available" : "unavailable")">@T[dish.IsAvailable ? "Available" : "Unavailable"]</span><span class="time-badge">@T[dish.PreparationTime <= 15 ? "Quick" : "Regular"]</span></div>
    </div>
    <div class="actions"><a class="button outline" asp-action="Delete" asp-route-id="@dish.Id">@T["Delete"]</a><a class="button primary" asp-action="Edit" asp-route-id="@dish.Id">@T["EditDish"] ↗</a></div>
</section>
<div class="detail-stats"><div><span>@T["Price"]</span><strong>@T.Price(dish.Price) ₫</strong></div><div><span>@T["PreparationTime"]</span><strong>@dish.PreparationTime @T["Minutes"]</strong></div><div><span>@T["Category"]</span><strong>@dish.DishCategory.Name</strong></div></div>
<div class="results-heading"><h2>@T["Images"] <span class="count">@dish.Images.Count</span></h2><a class="button outline" href="#add-image">＋ @T["AddImageUrl"]</a></div>
@if (dish.Images.Count == 0) { <div class="empty small"><h2>@T["NoImages"]</h2><p>@T["NoImagesHint"]</p></div> }
else
{
    <div class="image-grid">
    @foreach (var image in dish.Images.OrderByDescending(x => x.IsThumbnail).ThenBy(x => x.Id))
    {
        <article class="image-card">
            <div class="gallery-image"><img src="@image.ImageUrl" alt="@dish.Name" /><span class="image-fallback" hidden>@T["ImageUnavailable"]</span></div>
            <div class="image-actions">
                @if (image.IsThumbnail) { <span class="time-badge quick">@T["Thumbnail"]</span> }
                else { <form asp-action="SetThumbnail" method="post"><input name="id" type="hidden" value="@image.Id" /><button class="text-link" type="submit">@T["SetThumbnail"]</button></form> }
                <a class="text-link" asp-action="EditImage" asp-route-id="@image.Id">@T["EditImageUrl"]</a>
                <form asp-action="DeleteImage" method="post" data-confirm="@T["DeleteImageConfirm"]"><input name="id" type="hidden" value="@image.Id" /><button type="submit" class="text-link danger">@T["Delete"]</button></form>
            </div>
        </article>
    }
    </div>
}
<form asp-action="AddImage" method="post" class="editor-panel image-form" id="add-image">
    <h2>@T["AddImageUrl"]</h2>
    <input asp-for="Image.DishId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field"><label asp-for="Image.ImageUrl">@T["ImageUrl"] <span>*</span></label><input asp-for="Image.ImageUrl" maxlength="2048" placeholder="https://…" /><span asp-validation-for="Image.ImageUrl" class="validation"></span><p class="hint">@T["ImageHint"]</p></div>
    <label class="checkbox"><input asp-for="Image.IsThumbnail" /> @T["Thumbnail"]</label>
    <div class="form-actions"><button class="button primary" type="submit">@T["AddImage"] ＋</button></div>
</form>
